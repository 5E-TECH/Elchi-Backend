{
  "name": "elchi-pochta",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:all",
    "build:all": "nest build api-gateway && nest build identity-service && nest build order-service && nest build catalog-service && nest build logistics-service && nest build finance-service && nest build notification-service && nest build integration-service && nest build analytics-service && nest build branch-service && nest build investor-service && nest build file-service && nest build c2c-service && nest build search-service && nest build ai-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:gateway": "nest start api-gateway --watch",
    "start:identity": "nest start identity-service --watch",
    "start:order": "nest start order-service --watch",
    "start:catalog": "nest start catalog-service --watch",
    "start:logistics": "nest start logistics-service --watch",
    "start:finance": "nest start finance-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:integration": "nest start integration-service --watch",
    "start:analytics": "nest start analytics-service --watch",
    "start:branch": "nest start branch-service --watch",
    "start:investor": "nest start investor-service --watch",
    "start:file": "nest start file-service --watch",
    "start:c2c": "nest start c2c-service --watch",
    "start:search": "nest start search-service --watch",
    "start:ai": "nest start ai-service --watch",
    "start:all": "concurrently \"npm run start:gateway\" \"npm run start:identity\" \"npm run start:order\" \"npm run start:catalog\" \"npm run start:logistics\" \"npm run start:finance\" \"npm run start:notification\" \"npm run start:integration\" \"npm run start:analytics\" \"npm run start:branch\" \"npm run start:investor\" \"npm run start:file\" \"npm run start:c2c\" \"npm run start:search\" \"npm run start:ai\"",
    "start:prod:gateway": "node dist/apps/api-gateway/main.js",
    "start:prod:identity": "node dist/apps/identity-service/main.js",
    "start:prod:order": "node dist/apps/order-service/main.js",
    "start:prod:catalog": "node dist/apps/catalog-service/main.js",
    "start:prod:logistics": "node dist/apps/logistics-service/main.js",
    "start:prod:finance": "node dist/apps/finance-service/main.js",
    "start:prod:notification": "node dist/apps/notification-service/main.js",
    "start:prod:integration": "node dist/apps/integration-service/main.js",
    "start:prod:analytics": "node dist/apps/analytics-service/main.js",
    "start:prod:branch": "node dist/apps/branch-service/main.js",
    "start:prod:investor": "node dist/apps/investor-service/main.js",
    "start:prod:file": "node dist/apps/file-service/main.js",
    "start:prod:c2c": "node dist/apps/c2c-service/main.js",
    "start:prod:search": "node dist/apps/search-service/main.js",
    "start:prod:ai": "node dist/apps/ai-service/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "test:ci": "jest --runInBand --ci",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d typeorm.config.ts",
    "migration:generate:init": "npx typeorm-ts-node-commonjs migration:generate migrations/InitSchema -d typeorm.config.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d typeorm.config.ts",
    "db:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/db-prepare.ts",
    "db:check-cashbox": "node -r ts-node/register -r tsconfig-paths/register scripts/check-cashbox-invariant.ts",
    "db:reconcile": "node -r ts-node/register -r tsconfig-paths/register scripts/check-cashbox-invariant.ts --reconcile-strict",
    "telegram:setup": "node -r ts-node/register -r tsconfig-paths/register scripts/telegram-setup.ts",
    "db:prune-activity-logs": "node -r ts-node/register -r tsconfig-paths/register scripts/prune-activity-logs.ts",
    "db:sync:sato": "node -r ts-node/register -r tsconfig-paths/register scripts/sync-logistics-sato.ts",
    "openapi:generate": "node -r ts-node/register -r tsconfig-paths/register scripts/generate-openapi.ts",
    "ai:eval": "node -r ts-node/register -r tsconfig-paths/register scripts/ai-eval.ts",
    "audit:frontend": "node scripts/audit-frontend-coverage.mjs",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d typeorm.config.ts",
    "infra:up": "docker compose up rabbitmq postgres -d",
    "infra:down": "docker compose down",
    "infra:up:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "infra:down:prod": "docker compose -f docker-compose.prod.yml down",
    "db:backup": "bash scripts/backup-db.sh",
    "migration:run:safe": "bash scripts/pre-migration-backup.sh && npm run migration:run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^11.1.13",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.24",
    "@sentry/node": "^10.53.1",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^0.10.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "undici": "^6.29.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "node_modules/(@nestjs/jwt|promise-breaker)/.+\\.js$": "<rootDir>/tests/jest/esm-package.transformer.js",
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@nestjs/jwt|promise-breaker)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  },
  "overrides": {
    "multer": "^2.3.0",
    "brace-expansion": "^2.0.2"
  }
}
