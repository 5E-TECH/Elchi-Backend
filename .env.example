# ================= Runtime =================
NODE_ENV=development
PORT=3004

# ================= Service Ports =================
IDENTITY_PORT=3001
ORDER_PORT=3002
CATALOG_PORT=3003
LOGISTICS_PORT=3004
FINANCE_PORT=3005
NOTIFICATION_PORT=3006
INTEGRATION_PORT=3007
ANALYTICS_PORT=3008
BRANCH_PORT=3009
INVESTOR_PORT=3010
FILE_PORT=3011
C2C_PORT=3012
SEARCH_PORT=3013

# ================= Auth / JWT =================
# REQUIRED: >=32 chars of random entropy. Boot FAILS on weak/placeholder values.
# Generate each with: openssl rand -hex 32   (gateway + identity must MATCH for ACCESS_TOKEN_KEY)
ACCESS_TOKEN_KEY=__REPLACE_WITH_openssl_rand_hex_32__
ACCESS_TOKEN_TIME=15m
REFRESH_TOKEN_KEY=__REPLACE_WITH_openssl_rand_hex_32__
REFRESH_TOKEN_TIME=7d
# Per-IP rate limit for POST /auth/refresh, separate from the login limit
# (AUTH_THROTTLE_LIMIT, default 30/min). Every open tab refreshes at shift
# start, so keep it well above the login limit. Recreate api-gateway to apply.
AUTH_REFRESH_THROTTLE_LIMIT=60
AUTH_REFRESH_THROTTLE_TTL_MS=60000

# ================= RabbitMQ =================
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672
RABBITMQ_IDENTITY_QUEUE=identity_queue
RABBITMQ_ORDER_QUEUE=order_queue
# Gateway realtime push consumer queue (socket.io notifications). Optional.
RABBITMQ_GATEWAY_QUEUE=gateway_queue
RABBITMQ_CATALOG_QUEUE=catalog_queue
RABBITMQ_LOGISTICS_QUEUE=logistics_queue
RABBITMQ_FINANCE_QUEUE=finance_queue
RABBITMQ_NOTIFICATION_QUEUE=notification_queue
RABBITMQ_INTEGRATION_QUEUE=integration_queue
RABBITMQ_ANALYTICS_QUEUE=analytics_queue
RABBITMQ_BRANCH_QUEUE=branch_queue
RABBITMQ_INVESTOR_QUEUE=investor_queue
RABBITMQ_FILE_QUEUE=file_queue
RABBITMQ_C2C_QUEUE=c2c_queue
RABBITMQ_SEARCH_QUEUE=search_queue
# Per-consumer prefetch (Scale NOW-1): max unacked messages one service instance
# holds, i.e. RMQ backpressure. Unset => NestJS default 0 (unlimited in-flight),
# which lets a burst flood one event loop past the RPC timeouts. 20 is a safe
# default; raise for the finance consumer if it becomes the hot path.
RMQ_PREFETCH=20

# ================= PostgreSQL =================
POSTGRES_USER=elchi_app
# REQUIRED: strong, unique. Do NOT ship a dictionary word. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=__REPLACE_WITH_A_STRONG_DB_PASSWORD__
POSTGRES_DB=elchipochta_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Must match POSTGRES_USER/PASSWORD/HOST/DB above.
POSTGRES_URI=postgres://elchi_app:__REPLACE_WITH_A_STRONG_DB_PASSWORD__@postgres:5432/elchipochta_db

# DB backups (db-backup sidecar; runbook docs/ops/db-backups.md). The defaults
# ARE the requirement (daily 05:00 Asia/Tashkent, keep 7) — set only to change.
# BACKUP_DAILY_AT=05:00
# BACKUP_TZ=Asia/Tashkent
# BACKUP_DAILY_KEEP=7
# Optional off-box copy — needs aws/mc, which the postgres:15 image lacks.
# BACKUP_S3_TARGET=

# Per-service pg connection pool (Scale NOW-2). Default 10/service; with 11
# DB-backed services that is ~110 demanded, so docker-compose.prod.yml raises
# Postgres max_connections to 200 and overrides DB_POOL_MAX per service
# (order=20, finance=20, ai=5, others default). Keep SUM(DB_POOL_MAX) well under
# max_connections with headroom for migrations/admin. min=0 keeps idle cheap.
# DB_POOL_MAX=10
# DB_POOL_MIN=0

# ================= Schema per service =================
# DB_SCHEMA=identity_schema
# DB_SCHEMA=order_schema
# DB_SCHEMA=catalog_schema
# DB_SCHEMA=logistics_schema
# DB_SCHEMA=finance_schema
# DB_SCHEMA=notification_schema
# DB_SCHEMA=integration_schema
# DB_SCHEMA=branch_schema
# DB_SCHEMA=investor_schema
# DB_SCHEMA=c2c_schema
# DB_SCHEMA=search_schema
# DB_SCHEMA=ai_schema

# ================= Superadmin Seed =================
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PHONE_NUMBER=+998900000000
# REQUIRED: strong, unique, >=12 chars. Boot FAILS on known weak/default passwords.
SUPERADMIN_PASSWORD=__REPLACE_WITH_A_STRONG_PASSWORD__

# ================= MinIO / File Service =================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# REQUIRED: NOT the "minioadmin" default. Generate with: openssl rand -hex 16
MINIO_ACCESS_KEY=__REPLACE_WITH_A_NON_DEFAULT_ACCESS_KEY__
# REQUIRED: >=16 chars, not the default. Generate with: openssl rand -hex 24
MINIO_SECRET_KEY=__REPLACE_WITH_openssl_rand_hex_24__
MINIO_BUCKET=elchi-files
FILE_SIGNED_URL_EXPIRES=3600
FILE_MAX_SIZE_MB=10

# ================= Telegram =================
# (ZlpXb4Wh, ega qarori) BITTA bot, BITTA token — bildirishnoma va ikki
# yo'nalishli bot shu token bilan (eski ORDER_BOT_TOKEN ishlatilmaydi).
# ⚠️ DEV uchun ALOHIDA bot tokeni MAJBURIY: prod tokeni lokal .env ga
# nusxalansa, lokal konteyner prod botning update'larini o'ziga tortadi.
# Bo'sh yoki `replace_me` — bot o'chiq (chiquvchi xabar ham yuborilmaydi).
TELEGRAM_BOT_TOKEN=replace_me
# Kiruvchi update rejimi: auto | webhook | polling | off. `auto` — token va
# TELEGRAM_WEBHOOK_SECRET bo'lsa webhook; aks holda off (polling faqat leader).
TELEGRAM_BOT_MODE=auto
# Webhook: POST /telegram/webhook/<TELEGRAM_BOT_SLUG>; Telegram har so'rovda
# X-Telegram-Bot-Api-Secret-Token yuboradi (setWebhook secret_token). 16–256
# belgi [A-Za-z0-9_-] — `openssl rand -hex 32`. api-gateway VA
# notification-service ikkalasida bir xil bo'lishi shart.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_SLUG=elchi
# scripts/telegram-setup.ts (`npm run telegram:setup`) uchun to'liq URL.
TELEGRAM_WEBHOOK_URL=
# Polling zaxirasi faqat shu bayroq `1` bo'lgan BITTA konteynerda (409 Conflict yo'q).
BOT_POLLING_LEADER=0
# (rCFZAmOz) Shaxsiy Telegram ulash: profildagi havola t.me/<username>?start=<token>.
# Username bo'lmasa javobda faqat `/start <token>` buyrug'i qaytadi.
TELEGRAM_BOT_USERNAME=
# (6jXw0DDr) Bog'lash endi BIR MARTALIK DB kodi (telegram_link_tokens) —
# TELEGRAM_LINK_SECRET ishlatilmaydi.
# (xC88d8kH) Mini App / bot aktori access tokeni muddati (refresh yo'q).
TELEGRAM_ACCESS_TOKEN_TIME=30m
# Bot aktor nomidan mavjud gateway endpointlarini chaqiradi (ichki tarmoq).
ELCHI_GATEWAY_INTERNAL_URL=http://api-gateway:3004
# "🌐 Kabinetda ochish" tugmalari (bot kartalari) uchun panel manzili.
ELCHI_CABINET_URL=https://admin.elchipochta.uz
# (4BirMSVp) Kuryer kunlik hisoboti avtomatik (Asia/Tashkent, `0 0 21 * * *`).
# Bo'sh — faqat /kun buyrug'i.
COURIER_DAILY_REPORT_CRON=
# (rzGKtE9N / TgYRqaTk) Admin Telegram guruhi chat id si (odatda manfiy,
# -100…). Ixtiyoriy — bo'sh bo'lsa boot yiqilmaydi. TELEGRAM_ADMIN_GROUP_ID — sinonim.
NOTIFICATION_ADMIN_GROUP_ID=
TELEGRAM_ADMIN_GROUP_ID=
# Web Push (notification-service). Bir marta yarating: `npx web-push generate-vapid-keys`.
# Qayta yaratilsa barcha obunalar o'ladi. Bo'sh bo'lsa push o'chiq (servis baribir ishlaydi).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@elchipochta.uz
# ── SMS (notification-service). Sukut: o'chiq. Kredensiallar (Eskiz login/parol/alfa-nom)
# .env ga YOZILMAYDI — superadmin PUT /notifications/sms/accounts orqali DB ga shifrlab saqlaydi.
SMS_ENABLED=false
SMS_PROVIDER=eskiz
SMS_DAILY_CAP=500
# rkz0yBxr: OTP (security) — alohida kunlik kvota, reklama bilan umumiy EMAS
SMS_OTP_DAILY_CAP=500
SMS_MAX_FANOUT=200
SMS_CRON_ENABLED=true
# Bir bo'lak narxi (so'm) — shartnomadagi qiymat; bo'sh bo'lsa narx hisoblanmaydi.
SMS_TARIFF_TRANSACTIONAL=
SMS_TARIFF_PROMO=
# openssl rand -hex 32
SMS_CREDENTIAL_SECRET=
SMS_DLR_SECRET=
SMS_DLR_CALLBACK_URL=https://api.elchipochta.uz/webhooks/sms
SMS_OPT_OUT_BASE_URL=https://api.elchipochta.uz/sms/stop
NOTIF_PROMO_QUIET_HOURS=18:00-09:00
# (7Ec56EIw) CRITICAL bildirishnoma shuncha daqiqada o'qilmasa va push yetmasa — SMS
# (bitta xabar uchun ATIGI BIR MARTA; SMS_ENABLED=false bo'lsa ketmaydi). 0 — o'chiq.
NOTIF_ESCALATION_MINUTES=10
# (7Ec56EIw) Onlayn foydalanuvchiga push yubormaslik. Gateway'da `realtime.presence.check`
# patterni deploy qilingandan keyingina true qiling.
NOTIF_PUSH_PRESENCE_CHECK=false
# (A1HzKEby) Bo'ron chegarasi: bir foydalanuvchiga bir TURDAGI xabar 1 soatda shuncha
# qatordan oshsa — yangi qator emas, oxirgisi yangilanadi (data.count oshadi). CRITICAL
# chegarasiz. 0 — o'chiq.
NOTIF_HOURLY_CAP_PER_TYPE=30
# (A1HzKEby) Inbox retention — kunlik cron partiyalab o'chiradi. Sukut O'CHIQ.
# Birinchi marta: avval NOTIF_RETENTION_DRY_RUN=true bilan yoqib, logdagi
# "o'chirishga loyiq" sonini tekshiring. priority=critical hech qachon o'chirilmaydi;
# UNREAD_DAYS > READ_DAYS bo'lishi SHART (aks holda retention ishlamaydi).
NOTIF_RETENTION_ENABLED=false
NOTIF_RETENTION_DRY_RUN=false
NOTIF_RETENTION_READ_DAYS=60
NOTIF_RETENTION_UNREAD_DAYS=180
NOTIF_RETENTION_BATCH_SIZE=5000
NOTIF_RETENTION_MAX_BATCHES=200
# Toshkent vaqti, sekund maydoni bilan (har kuni 03:30).
NOTIF_RETENTION_CRON_EXPR=0 30 3 * * *
SMS_BALANCE_ALERT_THRESHOLD=
SMS_ALERT_RECIPIENT_IDS=
# ── OTP (identity-service)
OTP_HASH_SECRET=
# Telegram WebApp (mini-app) URL — market menyusidagi «Buyurtma yaratish»
# tugmasi (bot TELEGRAM_BOT_TOKEN; URL ga token QO'SHILMAYDI). Bo'sh — tugmasiz.
ORDER_BOT_WEBAPP_URL=
# (MWYaqprw) Kuryer skan Mini App'i, masalan https://admin.elchipochta.uz/tg/scan — bo'sh: /ishim da "📷 Skaner" tugmasi yo'q
TELEGRAM_SCAN_WEBAPP_URL=

# (1tnpaIqd, ega qarori) Market qo'shimcha xarajatga shuncha daqiqada javob
# bermasa — AVTOMATIK tasdiqlanadi (order-service). Bo'sh — o'chiq.
EXTRA_COST_AUTO_APPROVE_MINUTES=
# Avtomatik tasdiqdan shuncha daqiqa oldin marketga oxirgi eslatma.
EXTRA_COST_AUTO_APPROVE_REMINDER_MINUTES=10

# (2crjWf7v) Kuryer kassasidagi naqd shu summadan (so'm) oshsa — kuniga bir
# marta "💰 Kassangizda X so'm — filialga topshiring" (finance-service).
# Bo'sh / 0 — o'chiq. Soat — Asia/Tashkent (sukut 18).
COURIER_CASH_REMINDER_THRESHOLD=
COURIER_CASH_REMINDER_HOUR=18

# ================= Integration Service =================
# AES key for encrypting external integration credentials (Yandex, SMS, etc.) at rest.
# MUST be >=32 random characters. Generate with: openssl rand -hex 32
# Rotating this invalidates existing encrypted credentials — plan a re-encrypt migration first.
INTEGRATION_CREDENTIAL_SECRET=replace_with_openssl_rand_hex_32
# SSRF guard: keep false in production. true lets integrations call
# private/loopback hosts (dev/testing against a local provider only).
INTEGRATION_ALLOW_PRIVATE_HOSTS=false

# ================= AI Order (ai-service) =================
# ai-service (port 3024) is the ONLY process that holds ANTHROPIC_API_KEY and
# calls Anthropic. The gateway reaches it over RMQ (RABBITMQ_AI_QUEUE).
RABBITMQ_AI_QUEUE=ai_queue
# OPTIONAL. Empty/unset => ai-service boots normally with AI OFF (parse answers
# reason 'disabled'). A non-empty value must start with sk-ant- or ai-service
# boot fails. ⚠️ NEVER commit a real sk-ant key: set it only in the server's
# .env.production over SSH, BEFORE the deploy (the deploy never writes that file).
# Server value shape: ANTHROPIC_API_KEY=__REPLACE_WITH_ANTHROPIC_API_KEY__
# (left empty here so a copied .env.example boots with AI OFF instead of failing).
ANTHROPIC_API_KEY=
# Gateway kill switch for POST /orders/ai-parse. Ship the first deploy with
# false; after flipping it, recreate api-gateway so it re-reads the env.
AI_ORDER_ENABLED=false
# Model ids: extraction, image (vision) extraction, cheap classification.
AI_ORDER_MODEL=claude-sonnet-5
AI_ORDER_VISION_MODEL=claude-sonnet-5
AI_CLASSIFY_MODEL=claude-haiku-4-5
# District LLM fallback (ai.district.pick). The full district list sits in the
# CACHED system prompt (~2.5k tokens), so the model's minimum cacheable prefix
# must be smaller: claude-sonnet-5 = 1024 (default). claude-haiku-4-5 (4096)
# never caches here — the service then falls back to the old per-request pool.
AI_DISTRICT_MODEL=claude-sonnet-5
# USD->UZS rate used for cost_uzs in ai_usage_log, and the per-order price
# (UZS) recorded as applied_price_uzs on order extraction calls.
AI_USD_UZS_RATE=12800
AI_ORDER_PRICE_UZS=300
# NFiXfmq6: global AI buyurtma narxi (so'm). Bo'sh — AI_ORDER_PRICE_UZS.
# Market yozuvidagi ai_price_per_order bo'lsa — o'sha (0 — bepul).
AI_PRICE_PER_ORDER=
# NFiXfmq6 marja paneli alert chegaralari.
AI_ALERT_CACHE_HIT_MIN_RATIO=0.5
AI_ALERT_MARKET_SPIKE_FACTOR=5
AI_ALERT_MARGIN_MIN_UZS=0
# Global daily spend breaker in USD (Tashkent day, fail-closed => reason
# 'cap_exceeded'). Warn at CAP*WARN_RATIO; a SUPERADMIN one-day raise is capped
# at AI_CAP_RAISE_MAX_USD.
AI_DAILY_USD_CAP=50
AI_CAP_WARN_RATIO=0.8
AI_CAP_RAISE_MAX_USD=50
# Per-user parse throttle on the gateway: LIMIT requests per TTL_MS window.
AI_PARSE_THROTTLE_LIMIT=10
AI_PARSE_THROTTLE_TTL_MS=60000
# ai-service consumer prefetch (channel QoS only: max concurrent AI calls).
AI_RMQ_PREFETCH=8

# ================= CORS =================
# Comma-separated list of allowed browser origins. localhost is always allowed.
# api.elchipochta.uz is required so the hosted Swagger UI can call the API.
CORS_ORIGINS=https://admin.elchipochta.uz,https://api.elchipochta.uz

# ================= Swagger (API docs) =================
# Swagger UI (/api) is protected by HTTP Basic Auth.
# In production Swagger is served only when SWAGGER_PASSWORD is set.
SWAGGER_USER=admin
SWAGGER_PASSWORD=change_me_swagger

# ================= Cloudflare Tunnel =================
# Token from Cloudflare Zero Trust -> Networks -> Tunnels.
# Used by the `cloudflared` service in docker-compose.prod.yml.
TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
