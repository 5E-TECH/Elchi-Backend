    {
      "name": "10. Posilkani yangilash",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/partner/shipments/{{shipment_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "partner",
            "shipments",
            "{{shipment_id}}"
          ]
        },
        "description": "Faqat yuborilgan maydonlar o'zgaradi; narx — qabul qilinmaguncha (§5.5).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cod_amount\": 90000,\n  \"subtotal\": 90000\n}",
          "options": {
            "raw": {
              "language": "json"
