          "path": [
            "partner",
            "shipments",
            "{{shipment_id}}",
            "cancel"
          ]
        },
        "description": "Bekor qilish 200; allaqachon bekor — 200 idempotent: true; yetkazilgan — 409 (§5.4). Sinovdan keyin A posilka shu bilan bekor qilinadi."
      },
      "event": [
        {
          "listen": "test",
          "script": {
