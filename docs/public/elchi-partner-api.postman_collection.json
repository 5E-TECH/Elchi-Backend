        "body": {
          "mode": "raw",
          "raw": "{\n  \"shipment_ids\": [\n    \"{{shipment_id}}\",\n    \"{{shipment_id_b}}\",\n    \"DEMO-ORDER-1\"\n  ]\n}",
          "options": {
